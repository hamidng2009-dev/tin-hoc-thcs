{"th":[
{"id":"6-tkb","l":6,"b":"11–12","ten":"Làm thời khoá biểu bằng bảng","muc":"Biết chèn bảng, nhập dữ liệu và định dạng bảng trong phần mềm soạn thảo văn bản.","cb":["Máy tính có phần mềm soạn thảo văn bản","Thời khoá biểu của lớp em để nhìn"],"buoc":["Mở văn bản mới và lưu với tên tkb.","Gõ tiêu đề “Thời khoá biểu”, chọn cỡ chữ 16, in đậm, căn giữa.","Chèn bảng 6 hàng, 6 cột (1 cột Tiết và 5 cột cho Thứ Hai đến Thứ Sáu).","Gõ tên các cột ở hàng đầu và số tiết 1 đến 5 ở cột đầu.","Nhập tên môn học vào các ô còn lại.","Chọn cả bảng, căn giữa chữ trong ô; in đậm hàng đầu.","Kẻ viền cho bảng và tô màu nền hàng đầu.","Đọc lại, sửa lỗi chính tả rồi lưu tệp."],"kt":["Bảng có đủ 6 hàng và 6 cột.","Tiêu đề đã căn giữa, in đậm.","Hàng đầu in đậm và có màu nền.","Không còn lỗi chính tả.","Đã lưu tệp có tên dễ nhớ."],"loi":"Nếu chèn thiếu hàng hoặc cột, dùng chức năng chèn hàng, chèn cột chứ không cần làm lại cả bảng."},
{"id":"6-tim","l":6,"b":"7","ten":"Tìm thông tin về một chủ đề trên Internet","muc":"Biết chọn từ khoá, tìm kiếm và kiểm tra nguồn thông tin.","cb":["Máy tính hoặc điện thoại có kết nối Internet","Vở hoặc tệp để ghi chú"],"buoc":["Chọn một chủ đề, ví dụ cách trồng cây trong chậu.","Mở trình duyệt và vào máy tìm kiếm.","Nhập từ khoá cụ thể, ví dụ “cách trồng cây cà chua trong chậu”.","Xem ba kết quả đầu tiên và xem trang nào do cơ quan hoặc trang chuyên môn đăng.","Chọn một trang đáng tin, đọc kĩ và ghi 3 ý chính cùng tên trang vào vở.","Thử một từ khoá khác (ngắn hơn hoặc dài hơn) và so sánh kết quả."],"kt":["Từ khoá cụ thể, không chỉ một từ chung chung.","Đã ghi lại tên trang lấy thông tin.","Có 3 ý chính viết bằng lời của em.","Đã so sánh kết quả của hai từ khoá."],"loi":"Không chép nguyên văn; hãy đọc rồi viết lại bằng lời của em."},
{"id":"6-scratch","l":6,"b":"17","ten":"Lập trình Scratch cho nhân vật đi theo hình vuông","muc":"Biết ghép khối lệnh, dùng khối lặp và chạy thử chương trình.","cb":["Máy tính có Scratch (hoặc dùng bản trực tuyến)"],"buoc":["Mở Scratch và chọn một nhân vật.","Kéo khối “khi bấm vào lá cờ xanh” vào vùng lập trình.","Ghép tiếp khối “lặp lại 4 lần”.","Trong khối lặp, đặt khối “di chuyển 50 bước” rồi khối “xoay phải 90 độ”.","Bấm cờ xanh và quan sát nhân vật.","Đổi 50 thành 100 rồi chạy lại để so sánh."],"kt":["Chương trình bắt đầu bằng khối cờ xanh.","Nhân vật đi theo đường hình vuông và quay về gần chỗ xuất phát.","Khi đổi 50 thành 100, hình vuông to hơn."],"loi":"Nếu nhân vật không đi theo hình vuông, kiểm tra lại số lần lặp (4) và góc xoay (90 độ)."},
{"id":"7-bangdiem","l":7,"b":"6–8","ten":"Lập bảng điểm có tổng và trung bình","muc":"Biết nhập dữ liệu, dùng công thức, hàm SUM, AVERAGE và sao chép công thức.","cb":["Phần mềm bảng tính (Excel hoặc tương tự)","Điểm 3 môn của 5 bạn (chọn số tuỳ ý)"],"buoc":["Mở bảng tính mới và lưu với tên bang-diem.","Gõ ở hàng 1: Họ tên, Toán, Văn, Anh, Tổng, Trung bình (cột A đến F).","Nhập tên và điểm của 5 bạn ở các hàng 2 đến 6.","Ở ô E2 gõ =SUM(B2:D2) rồi nhấn Enter.","Ở ô F2 gõ =AVERAGE(B2:D2) rồi nhấn Enter.","Chọn E2:F2, kéo ô điều khiển xuống hàng 6 để sao chép công thức.","Tính tay một dòng để đối chiếu kết quả.","Đổi thử một điểm và xem Tổng, Trung bình có tự thay đổi không."],"kt":["Công thức bắt đầu bằng dấu =.","Kết quả khớp với cách tính tay.","Khi đổi điểm, kết quả tự cập nhật.","Cả 5 dòng đều có Tổng và Trung bình."],"loi":"Quên dấu = ở đầu công thức thì ô sẽ hiện chữ chứ không tính."},
{"id":"7-trinhbay","l":7,"b":"9–10","ten":"Trình bày và in thử bảng điểm","muc":"Biết gộp ô, định dạng ô và số, xem trước khi in.","cb":["Bảng điểm đã làm ở bài thực hành trước"],"buoc":["Chèn thêm một hàng ở đầu bảng.","Chọn A1:F1, gộp ô và gõ tiêu đề “Bảng điểm”.","Đặt tiêu đề cỡ chữ 16, in đậm, căn giữa.","Tô màu nền hàng tên cột và in đậm hàng đó.","Kẻ viền cho toàn bảng và căn giữa các số liệu.","Chọn cột Trung bình, đặt định dạng số có 1 chữ số thập phân.","Mở xem trước khi in và chọn hướng trang cho vừa bảng.","Kiểm tra lại số liệu rồi lưu tệp."],"kt":["Tiêu đề nằm giữa bảng.","Hàng tên cột có màu nền.","Cột Trung bình có 1 chữ số thập phân.","Đã xem trước khi in.","Số liệu không sai sau khi thêm hàng."],"loi":"Khi chèn hàng, công thức tự điều chỉnh địa chỉ; hãy kiểm tra lại một công thức để chắc kết quả đúng."},
{"id":"8-doi-tien","l":8,"b":"5–6","ten":"Quy đổi tiền với địa chỉ tuyệt đối","muc":"Biết dùng địa chỉ tuyệt đối, sao chép công thức, sắp xếp và lọc dữ liệu.","cb":["Phần mềm bảng tính","Một tỉ giá giả định, ví dụ 1 USD = 25 000 đồng"],"buoc":["Gõ ở A1: Sản phẩm, B1: Giá (USD), C1: Giá (đồng); gõ ở E1 tỉ giá 25000.","Nhập 5 sản phẩm và giá USD ở A2:B6.","Ở ô C2 gõ =B2*$E$1.","Sao chép C2 xuống C6 và kiểm tra công thức ở C3.","Đổi tỉ giá ở E1 và xem cả cột C có thay đổi không.","Sắp xếp bảng theo cột Giá (USD) giảm dần.","Lọc để chỉ xem các sản phẩm có giá từ 10 USD trở lên."],"kt":["Công thức ở C3 là =B3*$E$1.","Đổi E1 thì mọi ô trong cột C đổi theo.","Bảng đã sắp xếp giảm dần.","Bộ lọc chỉ hiện các dòng thoả điều kiện."],"loi":"Nếu quên dấu $ ở E1, khi sao chép xuống thì công thức trỏ sang E2, E3 và cho kết quả sai."},
{"id":"9-thuchi","l":9,"b":"9a–13a","ten":"Bảng quản lí thu chi gia đình","muc":"Biết dùng xác thực dữ liệu, SUMIF, SUM và biểu đồ để quản lí thu chi.","cb":["Phần mềm bảng tính","Danh sách vài khoản thu chi giả định trong tháng"],"buoc":["Gõ tiêu đề cột: Ngày, Loại, Thu/Chi, Số tiền.","Đặt xác thực dữ liệu cho cột Loại: danh sách Ăn uống, Học tập, Đi lại, Khác.","Đặt xác thực dữ liệu cho cột Thu/Chi: danh sách Thu, Chi.","Nhập ít nhất 10 dòng giả định.","Dùng SUMIF để tính tổng Chi theo từng loại.","Dùng SUMIF tính tổng Thu và tổng Chi, rồi tính số tiền còn lại bằng tổng Thu trừ tổng Chi.","Vẽ biểu đồ tròn thể hiện các khoản chi theo loại.","Kiểm tra lại công thức và lưu tệp."],"kt":["Cột Loại và Thu/Chi chỉ cho chọn từ danh sách.","Tổng chi theo loại cộng lại bằng tổng Chi.","Số tiền còn lại bằng tổng Thu trừ tổng Chi.","Biểu đồ có tiêu đề và chú giải."],"loi":"Vùng điều kiện và vùng tính tổng trong SUMIF phải có cùng số dòng."},
{"id":"9-sosanh","l":9,"b":"14–16","ten":"Từ bài toán đến chương trình: in số lớn hơn","muc":"Biết xác định đầu vào, đầu ra, viết thuật toán, lập trình và chạy thử với nhiều bộ dữ liệu.","cb":["Phần mềm lập trình em đang học (ví dụ Scratch)","Giấy nháp để vẽ sơ đồ khối"],"buoc":["Xác định đầu vào (hai số a, b) và đầu ra (số lớn hơn).","Viết thuật toán: nhập a, b; nếu a > b thì in a, nếu không thì in b.","Vẽ sơ đồ khối cho thuật toán đó.","Viết chương trình theo thuật toán bằng phần mềm lập trình.","Chạy thử với cặp (5, 3) và kiểm tra kết quả.","Chạy thử với cặp (2, 7) rồi với cặp (4, 4).","Nếu có kết quả sai, tìm chỗ sai trong thuật toán hoặc lệnh và sửa."],"kt":["Đã nêu đúng đầu vào và đầu ra.","Chương trình in 5 cho cặp (5, 3).","Chương trình in 7 cho cặp (2, 7).","Đã thử trường hợp hai số bằng nhau (4, 4)."],"loi":"Nhiều bạn quên thử trường hợp hai số bằng nhau; hãy thử cả trường hợp đặc biệt."},
{"id":"8-scratch-diem","l":8,"b":"12–15","ten":"Scratch: hỏi điểm rồi nói Đạt hoặc Chưa đạt","muc":"Biết nhập dữ liệu, dùng khối rẽ nhánh, khối lặp và chạy thử với nhiều giá trị.","cb":["Máy tính có Scratch (hoặc dùng bản trực tuyến)","Vài giá trị điểm để thử: 7, 5, 4, 3"],"buoc":["Mở Scratch và chọn một nhân vật.","Kéo khối “khi bấm vào lá cờ xanh” vào vùng lập trình.","Ghép khối “hỏi … và đợi” và gõ câu hỏi “Điểm của em là bao nhiêu?”.","Ghép khối “nếu … thì … nếu không thì …” bên dưới.","Đặt điều kiện “câu trả lời > 4” (dùng khối so sánh và khối câu trả lời); điểm nguyên từ 5 trở lên thì lớn hơn 4.","Trong phần “thì” đặt khối “nói Đạt trong 2 giây”; trong phần “nếu không” đặt khối “nói Chưa đạt trong 2 giây”.","Chạy thử lần lượt với 7, 5, 4 và 3 rồi ghi lại kết quả.","Muốn nhập điểm cho 3 bạn, đặt phần hỏi và rẽ nhánh vào trong khối “lặp lại 3 lần”."],"kt":["Điểm 7 và 5 cho kết quả Đạt.","Điểm 4 và 3 cho kết quả Chưa đạt.","Chương trình dùng đủ ba loại khối: hỏi, rẽ nhánh, nói.","Bản lặp 3 lần hỏi được điểm của 3 bạn."],"loi":"Nếu phần mềm của em có khối so sánh “≥” thì dùng luôn; nếu không, với điểm nguyên hãy dùng “> 4”. Nếu điểm có phần lẻ, dùng “> 4,9”."},
{"id":"8-thiep-anh","l":8,"b":"8b–11b","ten":"Làm thiệp chúc mừng từ một bức ảnh","muc":"Biết cắt ảnh, chỉnh sáng, đổi kích thước, thêm chữ và lưu ảnh đúng cách.","cb":["Phần mềm chỉnh sửa ảnh","Một bức ảnh của em hoặc ảnh được phép sử dụng"],"buoc":["Mở ảnh và lưu ngay một bản sao để giữ ảnh gốc.","Dùng công cụ cắt bỏ phần thừa để chủ thể nằm gọn trong khung.","Tăng độ sáng và độ tương phản vừa phải nếu ảnh hơi tối.","Thu nhỏ ảnh về kích thước vừa phải để gửi qua mạng, giữ nguyên tỉ lệ khung hình.","Thêm lời chúc bằng chữ dễ đọc, màu tương phản với nền, không che chủ thể.","Thử một bộ lọc màu nhẹ và giữ lại nếu ảnh đẹp hơn.","Lưu thành ảnh JPG hoặc PNG với tên mới, ví dụ thiep.","Mở ảnh vừa lưu để kiểm tra lại."],"kt":["Ảnh gốc vẫn còn nguyên.","Chữ dễ đọc và không che chủ thể.","Ảnh không bị méo.","Đã lưu thành tệp ảnh mới."],"loi":"Dùng ảnh của người khác phải xin phép hoặc dùng ảnh được phép sử dụng."},
{"id":"8-bieudo","l":8,"b":"7","ten":"Vẽ biểu đồ cột và biểu đồ tròn từ số liệu","muc":"Biết chọn loại biểu đồ phù hợp, thêm tiêu đề và chú giải cho biểu đồ.","cb":["Phần mềm bảng tính","Số liệu giả định: điểm trung bình của 4 tổ; số học sinh giỏi, khá, trung bình của lớp"],"buoc":["Gõ bảng thứ nhất: cột Tổ và cột Điểm trung bình cho 4 tổ.","Chọn vùng dữ liệu (kèm hàng tiêu đề) rồi chèn biểu đồ cột.","Thêm tiêu đề cho biểu đồ và tên cho các trục.","Gõ bảng thứ hai: Giỏi, Khá, Trung bình và số học sinh tương ứng.","Chọn vùng dữ liệu của bảng thứ hai rồi chèn biểu đồ tròn.","Thêm tiêu đề và hiển thị chú giải hoặc phần trăm.","Viết một câu giải thích vì sao em chọn biểu đồ cột cho bảng 1 và biểu đồ tròn cho bảng 2."],"kt":["Biểu đồ cột có tiêu đề và so sánh được các tổ.","Biểu đồ tròn thể hiện được tỉ lệ các loại học lực.","Có chú giải rõ ràng.","Câu giải thích nêu đúng lí do chọn loại biểu đồ."],"loi":"Biểu đồ tròn chỉ nên dùng khi các phần cộng lại thành một tổng thể."},
{"id":"9-video","l":9,"b":"9b–13b","ten":"Dựng video giới thiệu lớp em","muc":"Biết lập kịch bản, chuẩn bị tư liệu, dựng, thêm chữ và nhạc rồi xuất video.","cb":["Phần mềm làm video","Ảnh hoặc đoạn quay của lớp (đã được các bạn đồng ý)","Nhạc nền được phép sử dụng"],"buoc":["Viết kịch bản gồm 5 cảnh, mỗi cảnh một câu mô tả.","Gom ảnh, đoạn quay và nhạc vào một thư mục, đặt tên theo từng cảnh.","Nhập tư liệu vào phần mềm.","Kéo tư liệu lên dòng thời gian đúng thứ tự trong kịch bản.","Cắt bỏ phần thừa và chỉnh thời lượng mỗi cảnh cho vừa đủ.","Thêm chuyển cảnh giữa các cảnh.","Thêm tiêu đề ở đầu và phụ đề cho lời bình.","Chèn nhạc nền và chỉnh nhỏ hơn giọng đọc.","Xem lại toàn bộ video và sửa lỗi.","Xuất video (ví dụ MP4) và lưu cả dự án."],"kt":["Video đúng thứ tự trong kịch bản.","Phụ đề đúng nội dung và dễ đọc.","Nhạc nền không át lời bình.","Đã xuất video và lưu dự án.","Chỉ dùng ảnh, nhạc được phép sử dụng."],"loi":"Nhiều bạn quên xin phép các bạn trong ảnh hoặc dùng nhạc có bản quyền; hãy kiểm tra trước khi chia sẻ."}
]}

